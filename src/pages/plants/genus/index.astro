---
import BrowseLayout from '../../../layouts/BrowseLayout.astro';
import { getCollection } from 'astro:content';
import { slugify } from '../../../lib/slugify';

const plants = await getCollection('plants');

const counts = new Map<string, number>();
for (const entry of plants) {
  counts.set(entry.data.genus, (counts.get(entry.data.genus) ?? 0) + 1);
}

const genera = Array.from(counts.entries())
  .map(([genus, count]) => ({ genus, slug: slugify(genus), count }))
  .sort((a, b) => a.genus.localeCompare(b.genus));
---

<BrowseLayout title="Shop by Genus">
  <h2 class="mb-4">Shop by Genus</h2>
  <ul class="list-unstyled">
    {genera.map(({ genus, slug, count }) =>
      <li class="mb-2">
        <a href={`${import.meta.env.BASE_URL}plants/genus/${slug}/`} class="font-weight-bold text-decoration-underline">
          {genus} <span class="text-body text-sm">({count})</span>
        </a>
      </li>
    )}
  </ul>
</BrowseLayout>
