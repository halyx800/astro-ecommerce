---
import Layout from '../layouts/Layout.astro';
import '../../assets/scss/astro-ecommerce.scss';
import Navbar from '../components/navbar';
import Footer from '../components/footer';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
	<main>
    <Navbar client:load />
    <div class="container mt-5 mb-5 text-center py-5">
      <h1 class="h2">Page Not Found</h1>
      <p class="text-body">
        Sorry, we couldn't find the page you were looking for. It may have
        been moved or no longer exists.
      </p>
      <div class="mt-4">
        <a href={`${import.meta.env.BASE_URL}`} class="btn btn-dark btn-lg me-2">Go to Homepage</a>
        <a href={`${import.meta.env.BASE_URL}shop/`} class="btn btn-white btn-lg me-2">Browse the Shop</a>
        <a href={`${import.meta.env.BASE_URL}search/`} class="btn btn-white btn-lg">Search</a>
      </div>
    </div>
    <Footer />
  </main>
</Layout>
