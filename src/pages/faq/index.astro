---
import Layout from '../../layouts/Layout.astro';
import '../../../assets/scss/astro-ecommerce.scss';
import Navbar from '../../components/navbar';
import { getEntry, render } from 'astro:content';

const entry = await getEntry('faqs', 'faq');
const { Content } = entry ? await render(entry) : { Content: null };
---

<Layout title="FAQ">
	<main>
    <Navbar client:load />
    <div class="container mt-5">
      <h1 class="h2 mb-4">Frequently Asked Questions</h1>

      {Content
        ? <div class="faq-content"><Content /></div>
        : <p class="text-body">No FAQs yet.</p>
      }
    </div>
  </main>
</Layout>

<style>
  .faq-content :global(h2) {
    font-size: 1.25rem;
  }
</style>
