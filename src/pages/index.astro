---
import Layout from '../layouts/Layout.astro';
import '../../assets/scss/astro-ecommerce.scss';
import Navbar from '../components/navbar';
import Footer from '../components/footer';
import CardProduct from '../components/products/cardProduct';
import ArticleTeaser from '../components/articles/articleTeaser';
import PromoSectionLarge from '../components/promo/promoSectionLarge';
import CategorySidebarRow from '../components/nav/CategorySidebarRow.astro';
import { getCollection } from 'astro:content';

const FEATURED_LIMIT = 8;

const plants = await getCollection('plants');
const supplies = await getCollection('supplies');
const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const featured = [
  ...plants.filter(entry => entry.data.featured).map(entry => ({
    kind: 'plants' as const,
    id: entry.id,
    title: entry.data.displayName,
    genus: entry.data.genus,
    tags: entry.data.tags,
    images: entry.data.images,
    variants: entry.data.variants,
  })),
  ...supplies.filter(entry => entry.data.featured).map(entry => ({
    kind: 'supplies' as const,
    id: entry.id,
    title: entry.data.name,
    genus: undefined,
    tags: entry.data.tags,
    images: entry.data.images,
    variants: entry.data.variants,
  })),
].slice(0, FEATURED_LIMIT);
---

<Layout title="Orchid Insanity">
	<main>
    <Navbar client:load />

    <PromoSectionLarge
      title="Welcome to Orchid Insanity!"
      full_description="Live orchids, growing supplies, and everything you need to keep them thriving."
      pageHeaderBgImg={`${import.meta.env.BASE_URL}/images/bg2.jpg`}
      pageHeaderMinVh="35vh"
    />

    <div class="container my-5">
      <CategorySidebarRow>
        {(featured.length > 0) &&
          <div class="mb-10">
            <div class="d-block text-center mb-5">
              <h3>Featured</h3>
            </div>
            <div class="row">
              {featured.map(item =>
                <div class="col-md-6 col-lg-4">
                  <CardProduct
                    thumb_src={item.images[0] ?? ''}
                    thumb_alt={item.title}
                    title={item.title}
                    genus={item.genus}
                    tags={item.tags}
                    variants={item.variants}
                    position="left"
                    href={`${import.meta.env.BASE_URL}/${item.kind}/${item.id}/`}
                  />
                </div>
              )}
            </div>
          </div>
        }

        <p class="text-center text-body mb-10">
          <a href={`${import.meta.env.BASE_URL}/plants/genus/`} class="font-weight-bold text-decoration-underline">Browse orchids by genus</a>
          &nbsp;·&nbsp;
          <a href={`${import.meta.env.BASE_URL}/supplies/category/`} class="font-weight-bold text-decoration-underline">Browse growing supplies</a>
          &nbsp;·&nbsp;
          <a href={`${import.meta.env.BASE_URL}/tags/`} class="font-weight-bold text-decoration-underline">Browse by tag</a>
        </p>

        {(articles.length > 0) &&
          <div class="mb-10">
            <div class="d-block text-center mb-5">
              <h3>From the Blog</h3>
              <a class="text-dark font-weight-bold" href={`${import.meta.env.BASE_URL}/articles/`}>Read more articles &#62;</a>
            </div>
            <div class="col-12">
              {articles.map(entry =>
                <ArticleTeaser
                  title={entry.data.title}
                  excerpt={entry.data.excerpt}
                  coverImage={entry.data.coverImage}
                  publishDate={entry.data.publishDate}
                  href={`${import.meta.env.BASE_URL}/articles/${entry.id}/`}
                />
              )}
            </div>
          </div>
        }
      </CategorySidebarRow>
    </div>

    <Footer />
  </main>
</Layout>
