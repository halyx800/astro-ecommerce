---
import Layout from './Layout.astro';
import '../../assets/scss/astro-ecommerce.scss';
import Navbar from '../components/navbar';
import CategorySidebarRow from '../components/nav/CategorySidebarRow.astro';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  ogTitle?: string;
  ogDescription?: string;
}

const { title, description, image, type, ogTitle, ogDescription } = Astro.props;
---

<Layout title={title} description={description} image={image} type={type} ogTitle={ogTitle} ogDescription={ogDescription}>
	<main>
    <Navbar client:load />
    <div class="container mt-5">
      <CategorySidebarRow>
        <slot />
      </CategorySidebarRow>
    </div>
  </main>
</Layout>
